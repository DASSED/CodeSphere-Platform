# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# SSO providers are enabled only when both the client id and the secret are set (#63).
# @optional
GITHUB_CLIENT_ID=
# @optional
GITHUB_CLIENT_SECRET=
# @optional
GITLAB_CLIENT_ID=
# @optional
GITLAB_CLIENT_SECRET=
# @optional
GOOGLE_CLIENT_ID=
# @optional
GOOGLE_CLIENT_SECRET=

# Comma-separated list of verified emails that receive the admin role (spec §2).
# @optional
ADMIN_EMAILS=

# Version of the consent text shown at sign-in; an account is created only with this version (spec §4).
CONSENT_VERSION=2026-10

# OpenTelemetry traces are off unless an OTLP/HTTP endpoint is set (e.g. http://localhost:4318)
# @optional @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=

# @optional
OTEL_EXPORTER_OTLP_HEADERS=

# @public @type=string(minLength=1)
OTEL_SERVICE_NAME=codesphere-server
