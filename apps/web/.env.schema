# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
NEXT_PUBLIC_SERVER_URL=

# Shows the "sign in with an email code" field. Must match EMAIL_OTP_SIGNIN on the server.
# @optional @public @type=boolean
NEXT_PUBLIC_EMAIL_OTP_SIGNIN=false

# Whether this deployment has a database. A preview without the `preview-db` label has none: the
# home page then does not ask for the hackathon, instead of logging a failed request (#157).
# @optional @public @type=boolean
NEXT_PUBLIC_HAS_DATABASE=true
