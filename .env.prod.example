# Copy to .env next to docker-compose.prod.yml on the server (chmod 600). Never commit the real file.
# In production the deploy workflow writes it from the PROD_COMPOSE_ENV secret (deploy/README.md).
PUBLIC_HOST=codesphereplatform.xyz
ADMIN_HOST=admin.codesphereplatform.xyz
ACME_EMAIL=ops@example.org
POSTGRES_PASSWORD=replace-with-a-long-random-value
# deploy/backup.sh: healthchecks.io ping of the nightly backup, and the rclone remote of the
# off-server copy (empty = disabled), e.g. r2-crypt:codesphere
BACKUP_HEARTBEAT_URL=https://hc-ping.com/replace-with-check-uuid
OFFSITE_REMOTE=
