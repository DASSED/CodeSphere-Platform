{
	"name": "@codesphere/db",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"check-types": "tsc -b",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate:deploy": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "bun src/seed/index.ts",
		"db:seed:test": "bun src/seed/test.ts",
		"db:local": "bun ../../scripts/db-local.mjs",
		"db:local:studio": "bun ../../scripts/db-local.mjs --studio"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.2.0",
		"drizzle-orm": "catalog:",
		"pg": "^8.23.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@codesphere/config": "workspace:*",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "1.0.0-rc.4",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"volta": {
		"extends": "../../package.json"
	}
}
