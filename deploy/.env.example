# Copy to deploy/.env.production and deploy/.env.staging on the server (chmod 600). Never commit the real files.
ENV_NAME=production
DOMAIN=codesphereplatform.xyz
IMAGE_TAG=replace-with-git-sha
POSTGRES_PASSWORD=replace-with-a-long-random-value
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# healthchecks.io ping URL for this environment (alerts the team when the nightly backup is missing)
BACKUP_HEARTBEAT_URL=https://hc-ping.com/replace-with-check-uuid
# rclone remote for the off-server copy (empty = disabled), e.g. codesphere-offsite:
OFFSITE_REMOTE=codesphere-offsite:
