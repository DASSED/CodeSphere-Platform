# Web and API on one origin per environment (decided: cookies "lax", no CORS).
# Service names resolve through the "edge" network as <compose project>-<service>-1.

# Every response (#54, spec §4). The pages' Content-Security-Policy, with its per-request nonce,
# comes from the Next.js proxy (apps/web/src/proxy.ts); the API gets a deny-all one below.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

codesphereplatform.xyz {
	import security_headers
	@api path /rpc* /api/* /mcp* /health /ready
	header @api Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	reverse_proxy @api codesphere-production-server-1:3000
	reverse_proxy codesphere-production-web-1:3001
}

staging.codesphereplatform.xyz {
	import security_headers
	@api path /rpc* /api/* /mcp* /health /ready
	header @api Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	reverse_proxy @api codesphere-staging-server-1:3000
	reverse_proxy codesphere-staging-web-1:3001
}
